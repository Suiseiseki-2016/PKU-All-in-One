# ==============================================================================
# PKU All in One (Open-Source BYOK Edition) - Configuration Template
# ==============================================================================
# You can edit this `.env` file directly or configure AI providers visually from
# the Web UI ("模型配置" tab) after launching `uv run pku-sync panel`.
# All credentials and API keys remain strictly local on your machine.

# --- 1. PKU IAAA / Blackboard Credentials (optional; can also set in Web UI) --
# PKU_USERNAME=2300012345
# PKU_PASSWORD=your_iaaa_password

# Local course data directory (absolute path recommended if launched globally)
DATA_DIR=data

# Optional course filtering
# COURSE_ALLOWLIST=_104128_1,_101545_1
# COURSE_DENYLIST=
# 5-digit Blackboard term prefix (e.g. 26271 = 2026-27 term 1; empty = newest)
# COURSE_TERM=
# INCLUDE_PAST_TERMS=false

# In-memory Blackboard cookie cache TTL in seconds (default 720s; 0 = disable)
# PKU_SESSION_CACHE_TTL_SECONDS=720

# --- 2. BYOK Text LLM (notes, refined handouts, summary, quiz, grading) -------
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
NOTES_MODEL=deepseek-chat
# Optional separate model for refined handouts / logic map / summary (empty = reuse NOTES_MODEL)
REFINE_MODEL=
# Note strategy: topics (recommended) | transcript
NOTES_STRATEGY=topics

# CLI one-shot summary backend: auto | openai | claude | codex | droid
# LLM_PROVIDER=auto
# LLM_MODEL=
# LLM_TIMEOUT=600

# --- 3. BYOK Vision VLM (Blackboard & Slide OCR; empty fields inherit LLM) ---
VISION_ENABLED=true
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# --- 4. BYOK Speech-to-Text ASR ("openai" | "dashscope" | "local") ------------
TRANSCRIPTION_BACKEND=openai

# Used when TRANSCRIPTION_BACKEND=openai (empty base/key inherit OPENAI_*)
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# Used when TRANSCRIPTION_BACKEND=dashscope (Aliyun Bailian Qwen3-ASR)
DASHSCOPE_API_KEY=

# Used when TRANSCRIPTION_BACKEND=local (requires `uv sync --extra local-asr`)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- 5. Optional Notion Integration -------------------------------------------
# AGENT_HOST=claude
# NOTION_TOKEN=
# Optional self-hosted public Notion OAuth integration credentials:
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=

# --- 6. Local Recording Storage (zero-disk streaming by default) --------------
DELETE_VIDEO_AFTER_PROCESSING=true
SAVE_RECORDINGS_LOCALLY=false
RECORDINGS_DOWNLOAD_DIR=
